# SwachhAI Backend Environment Variables
# Copy this file to .env and fill in the actual values for your environment

# Server Configuration
PORT=3000

# MongoDB Connection String
# For development: mongodb://127.0.0.1:27017/swachhai
# For production: Use MongoDB Atlas or a cloud MongoDB service
# Example: mongodb+srv://username:password@cluster.mongodb.net/swachhai?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/swachhai?retryWrites=true&w=majority

# JWT Secret for token signing (use a strong random string)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_very_long_random_secret_string_here

# File Upload Configuration
# Directory to store uploaded files (default: uploads)
UPLOAD_DIR=uploads

# Admin User Seeding (optional, defaults provided)
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Administrator

# Frontend Directory (optional, auto-detected from 'public' or 'SwachAI')
# FRONTEND_DIR=/path/to/frontend
